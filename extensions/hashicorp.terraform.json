{
    "schemaVersion": 1,
    "id": "hashicorp.terraform",
    "publisher": "hashicorp",
    "name": "terraform",
    "displayName": "HashiCorp Terraform",
    "description": "Syntax highlighting and autocompletion for Terraform",
    "kind": "proxy-openvsx",
    "repository": "https://github.com/hashicorp/vscode-terraform",
    "license": "MPL-2.0",
    "homepage": "https://github.com/hashicorp/vscode-terraform#readme",
    "readme": "# HashiCorp Terraform\n\nTerraform language support powered by the bundled `terraform-ls` language server: syntax highlighting, hover, completion with provider schemas, go to definition and diagnostics for `.tf` and `.tfvars` files.\n\nThis is the unmodified extension published on Open VSX, pinned to a specific version and verified to work in Diode. The extension ships platform-specific builds with the native `terraform-ls` binary inside; the registry entry carries one artifact per platform.\n",
    "support": {
        "level": "partial",
        "works": [
            "Syntax highlighting for Terraform, tfvars, Terraform Stacks and test files",
            "Hover, completion with provider schemas, go to definition (F12) and diagnostics in Problems from the bundled terraform-ls"
        ],
        "limits": [
            "HCP Terraform, Providers and Module Calls views do not render yet: Diode has no extension tree views so far",
            "Sign-in to HCP Terraform is not supported yet",
            "Formatting and the init/validate/plan commands need the terraform CLI on PATH, as in VS Code"
        ]
    },
